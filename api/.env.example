# Supabase — server-side only. Never ship the service role key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session JWT signing secret (use 32+ random bytes).
SESSION_SECRET=

# Sign in with Apple — audience is the app bundle id for native SIWA.
APPLE_AUDIENCE=com.ctt.listingforge

# Email / OTP delivery. Defaults to Resend's REST API.
# If RESEND_API_KEY is unset, OTP codes are logged to the server console (dev only).
EMAIL_FROM=ListingForge <login@yourdomain.com>
RESEND_API_KEY=
