# StoreKit 2 signed transaction verification (separate from Sign in with Apple).
# Sandbox for local real-Apple testing; Production for release.
APP_STORE_ENVIRONMENT=Sandbox
# Numeric App Store Connect app ID; required for Production verification.
APP_STORE_APP_ID=
# Enable in production only when accepting real Apple sandbox purchases for App Review/TestFlight.
APP_STORE_ALLOW_SANDBOX=false
