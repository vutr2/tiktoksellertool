# Supabase — server-side only. Never ship the service role key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session JWT signing secret (use 32+ random bytes).
SESSION_SECRET=

# Sign in with Apple — audience is the app bundle id for native SIWA.
APPLE_AUDIENCE=com.ctt.listingforge

# Email / OTP delivery. Defaults to Resend's REST API.
# If RESEND_API_KEY is unset, OTP codes are logged to the server console (dev only).
EMAIL_FROM=ListingForge <login@yourdomain.com>
RESEND_API_KEY=

# ── Model providers (M3/M4) ──────────────────────────────────────────────────

# Claude — reads the product photo (vision) and writes the ad scripts.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-opus-5
ANTHROPIC_SCRIPT_MODEL=claude-sonnet-5

# Kling — generates BACKGROUNDS ONLY.
# SPEC §8: the product is never redrawn. Kling renders a scene; the original
# product pixels are composited onto it. Never send the product to a model.
KLING_API_KEY=
KLING_BASE_URL=https://api.klingai.com
# Per-render price from your actual invoice. Unset means cost is recorded as
# unknown rather than guessed — see src/lib/ai/pricing.ts.
KLING_COST_USD_PER_IMAGE=

# Langfuse — SPEC §3 requires tracing on ALL model calls.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
